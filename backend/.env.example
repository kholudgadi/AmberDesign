NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://amberdesign:amberdesign@localhost:5432/amberdesign?schema=public
JWT_ACCESS_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
