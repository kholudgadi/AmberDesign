NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL="postgresql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_POOLER_HOST:6543/DB_NAME?pgbouncer=true"
DIRECT_URL="postgresql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_DIRECT_HOST:5432/DB_NAME"
JWT_ACCESS_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
# For local/non-Google hosting, use one of these approaches:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-me
# Keep mock for local development. For Moyasar test mode, use an sk_test_ key.
MOYASAR_SECRET_KEY=
MOYASAR_API_BASE=https://api.moyasar.com/v1
